{
  "name": "voice-archive-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "npm run format:check && npm run lint && npm test && npm run build && npm run build-storybook",
    "api:check": "node scripts/api-generate.ts --check",
    "api:regenerate": "node scripts/api-generate.ts --write",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rtk-query/codegen-openapi": "2.2.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "orval": "8.43.0",
    "openapi-types": "12.1.3",
    "oxlint": "^1.79.0",
    "prettier": "3.9.10",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
